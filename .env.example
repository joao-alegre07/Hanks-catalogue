# --- catálogo (app) ---
SECRET_KEY=
TMDB_API_KEY=

# --- banco compartilhado (usado pelos dois serviços) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

PORT=5000

# URL pública do catálogo -- usada pelo auth-service pra montar o link
# do e-mail de "esqueci minha senha" (ex: https://seu-subdominio.lapps.studio)
PUBLIC_APP_URL=

# --- serviço de autenticação (auth) ---
# Em produção o catálogo chama o auth pelo nome do serviço na rede interna
# do Docker (ver docker-compose.yml); isso não é segredo, mas fica aqui
# pra rodar localmente com docker-compose.dev.yml.
AUTH_SERVICE_URL=http://auth:5001

# credenciais SMTP (Mailtrap em dev, Brevo em produção)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@catalogo-filmes.local
